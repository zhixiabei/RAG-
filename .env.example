APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8080

AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-strong-password
AUTH_SECRET=replace-with-random-secret-at-least-32-chars
AUTH_OWNER_ID=personal
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:6008,http://localhost:6008

DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=rag-documents

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag_chunks_qwen3_embedding
QDRANT_TIMEOUT_SECONDS=30
QDRANT_UPSERT_BATCH_SIZE=32
QDRANT_UPSERT_MAX_RETRIES=2

# Two documents may upload/parse concurrently; local embedding remains serialized for stability.
INGESTION_MAX_CONCURRENCY=2
INGESTION_EMBEDDING_MAX_CONCURRENCY=1
INGESTION_EMBEDDING_BATCH_SIZE=32
# 0 disables the knowledge-base document size limit. Chat attachments still have a separate limit.
MAX_DOCUMENT_BYTES=0

MODEL_MODE=local

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Used when MODEL_MODE=remote.
REMOTE_LLM_PROVIDER_NAME=DeepSeek
REMOTE_LLM_BASE_URL=https://api.deepseek.com
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODELS=deepseek-chat,deepseek-reasoner
REMOTE_DEFAULT_CHAT_MODEL=deepseek-chat

# DeepSeek does not provide embeddings. Configure an OpenAI-compatible embedding API.
REMOTE_EMBEDDING_PROVIDER_NAME=
REMOTE_EMBEDDING_BASE_URL=
REMOTE_EMBEDDING_API_KEY=
REMOTE_EMBEDDING_MODEL=

RAG_RETRIEVAL_TOP_K=50
RAG_CONTEXT_TOP_K=8
RAG_RELEVANCE_THRESHOLD=0.65
RAG_CONTEXT_MAX_CHARS=12000
