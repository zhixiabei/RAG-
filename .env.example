APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8080

OWNER_ID=personal
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=rag-documents

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag_chunks_qwen3_embedding
# Multiple routing points per file: identity, summary, topics, and sections.
QDRANT_DOCUMENT_COLLECTION=rag_documents_qwen3_embedding
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_HNSW_FULL_SCAN_THRESHOLD=10000
QDRANT_SEARCH_HNSW_EF=64

MODEL_MODE=local

OLLAMA_URL=http://127.0.0.1:11434
# 意图识别固定使用本地 Ollama 小模型，即使 MODEL_MODE=remote。
OLLAMA_CHAT_MODEL=qwen3:4b
RAG_DECISION_MODEL=qwen2.5:0.5b
RAG_DECISION_KEEP_ALIVE=30m
RAG_QUERY_PLANNING_ENABLED=true
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Used when MODEL_MODE=remote.
REMOTE_LLM_PROVIDER_NAME=DeepSeek
REMOTE_LLM_BASE_URL=https://api.deepseek.com
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODELS=deepseek-chat,deepseek-reasoner
REMOTE_DEFAULT_CHAT_MODEL=deepseek-chat

# DeepSeek does not provide embeddings. Configure an OpenAI-compatible embedding API.
REMOTE_EMBEDDING_PROVIDER_NAME=SiliconFlow
REMOTE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
REMOTE_EMBEDDING_API_KEY=
REMOTE_EMBEDDING_MODEL=Pro/BAAI/bge-m3

# Main RAG model must fail before the outer 90-second evaluation request timeout.
REMOTE_LLM_TIMEOUT_SECONDS=60
REMOTE_LLM_MAX_RETRIES=0
# Embedding retries also cover intermittent HTTP 400 responses from the provider.
REMOTE_EMBEDDING_MAX_RETRIES=2
REMOTE_LLM_RETRY_BASE_DELAY_SECONDS=0.5
REMOTE_LLM_RETRY_MAX_DELAY_SECONDS=5

RAG_TOP_K=10
RAG_RETRIEVAL_CANDIDATE_K=30
# First-stage file recall pool. All files passing the score threshold are kept.
RAG_DOCUMENT_CANDIDATE_K=50
RAG_DOCUMENT_SCORE_THRESHOLD=0.45
RAG_RERANK_ENABLED=true
# Empty provider/base URL/API key values reuse REMOTE_EMBEDDING_*.
RAG_RERANK_PROVIDER_NAME=
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TIMEOUT_SECONDS=60
# Reranker results below this score are treated as unrelated. Only applies when a relevance score is available.
RAG_MIN_RELEVANCE_SCORE=0.1
# 0 means infer a conservative limit from the selected model name.
RAG_CONTEXT_MAX_INPUT_TOKENS=0
RAG_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
RAG_CONTEXT_HISTORY_MAX_TOKENS=6000
RAG_CONTEXT_CATALOG_MAX_TOKENS=3000
RAG_CONTEXT_ATTACHMENT_MAX_TOKENS=10000
RAG_CONTEXT_COMPRESSION_ENABLED=true
RAG_CONTEXT_COMPRESSION_MODEL=qwen3:4b
RAG_CONTEXT_COMPRESSION_INPUT_TOKENS=6000
RAG_CONTEXT_COMPRESSION_OUTPUT_TOKENS=1000
# Hard generation ceiling for the final answer. Prompt guidance usually keeps answers shorter.
RAG_ANSWER_MAX_OUTPUT_TOKENS=1200


# LLM-as-a-Judge for answer-quality evaluation. Empty endpoint/model values reuse the active chat service/model.
RAG_JUDGE_ENABLED=true
RAG_JUDGE_PROVIDER_NAME=
RAG_JUDGE_BASE_URL=
RAG_JUDGE_API_KEY=
RAG_JUDGE_MODEL=
RAG_JUDGE_PASS_THRESHOLD=0.7
RAG_JUDGE_MAX_EVIDENCE_CHARS=12000
RAG_JUDGE_MAX_OUTPUT_TOKENS=300
RAG_JUDGE_MAX_CONCURRENCY=1
# Dedicated OpenAI-compatible Judge endpoint reliability settings.
RAG_JUDGE_TIMEOUT_SECONDS=60
RAG_JUDGE_MAX_RETRIES=0
RAG_JUDGE_RETRY_BASE_DELAY_SECONDS=1
RAG_JUDGE_RETRY_MAX_DELAY_SECONDS=5

# Evaluation runs samples concurrently; Judge concurrency is capped separately above.
EVALUATION_REQUEST_TIMEOUT_SECONDS=90
EVALUATION_MAX_CONCURRENCY=2
# Local evaluation fallback. All *.jsonl files in this directory are merged.
EVALUATION_DATASET_DIR=testsets

# Optional: push the exact RAG chunks and IDs into the test-set workshop.
TESTSET_TOOL_BASE_URL=http://localhost:3000
TESTSET_TOOL_SYNC_TIMEOUT_SECONDS=60

# Keep ingestion serialized unless the server has enough memory for parallel parsing and embedding.
INGESTION_MAX_CONCURRENCY=2
INGESTION_EMBEDDING_MAX_CONCURRENCY=1
INGESTION_EMBEDDING_BATCH_SIZE=32
MAX_DOCUMENT_BYTES=0
